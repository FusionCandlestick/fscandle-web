{
  "name": "fscandle-web",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing site and interactive playground for FusionCandlestick (fscandle).",
  "license": "SEE LICENSE IN https://github.com/FusionCandlestick/fscandle/blob/main/LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/serve-export.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "capture:media": "node scripts/capture-media.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:perf:browser": "node tests/performance/browser-frame-benchmark.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fscandle": "file:vendor/fscandle-0.1.0-067c4b1.tgz",
    "lucide-react": "^1.8.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5"
  }
}
